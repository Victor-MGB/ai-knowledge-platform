# KnowFlow backend configuration. Copy to .env and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Auth
JWT_SECRET=knowflow-dev-secret-change-me
JWT_ISSUER=knowflow
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10
# Points at the pgvector container from Day 3 (localhost:5434).
DB_HOST=localhost
DB_PORT=5434
DB_USER=knowflow
DB_PASSWORD=knowflow
DB_NAME=knowflow