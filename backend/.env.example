# KnowFlow backend configuration. Copy to .env and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Auth
JWT_SECRET=knowflow-dev-secret-change-me
JWT_ISSUER=knowflow
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10
# Points at the pgvector container from Day 3 (localhost:5434).
DB_HOST=localhost
DB_PORT=5434
DB_USER=knowflow
DB_PASSWORD=knowflow
DB_NAME=knowflow

# S3-compatible storage - MinIO from Day 8 (localhost:9000 API / 9001 console).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowflow
S3_ACCESS_KEY=knowflow
S3_SECRET_KEY=knowflow123
S3_FORCE_PATH_STYLE=true
# Upload ceiling (25 MiB dev default).
MAX_UPLOAD_BYTES=26214400

# The AI service (Day 12 queue forwarding + Day 15 query embedding).
AI_SERVICE_URL=http://127.0.0.1:8001
AI_ENQUEUE_TIMEOUT_MS=5000
AI_EMBED_TIMEOUT_MS=5000