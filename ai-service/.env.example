# KnowFlow AI service configuration.
# Copy to .env and adjust. Environment variables override these values.

ENVIRONMENT=development
DEBUG=false

# Embedding provider: hash (local, offline) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=knowflow-hash-384
EMBEDDING_DIMENSIONS=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM provider: mock (local, offline) | openai
LLM_PROVIDER=mock
LLM_MODEL=knowflow-mock-1
OPENAI_LLM_MODEL=gpt-4o-mini

# OpenAI-compatible API (only needed when a provider is set to openai)
OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-...  # never commit real keys