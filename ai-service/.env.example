# KnowFlow AI service configuration.
# Copy to .env and adjust. Environment variables override these values.

ENVIRONMENT=development
DEBUG=false

# Embedding provider: hash (local, offline) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=knowflow-hash-384
EMBEDDING_DIMENSIONS=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM provider: mock (local, offline) | openai
LLM_PROVIDER=mock
LLM_MODEL=knowflow-mock-1
OPENAI_LLM_MODEL=gpt-4o-mini

# OpenAI-compatible API (only needed when a provider is set to openai)
OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-...  # never commit real keys

# Document processor (Day 9) — connects back to the Day-3/5 Postgres and the
# Day-8 MinIO bucket. Defaults match the local dev containers.
DATABASE_URL=postgres://knowflow:knowflow@localhost:5434/knowflow
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=knowflow
S3_ACCESS_KEY=knowflow
S3_SECRET_KEY=knowflow123
S3_FORCE_PATH_STYLE=true
# PDF_PAGE_LIMIT=1000   # extraction caps, in case a hostile upload explodes

# Embedding pipeline (Day 11) — batching + retry for the /v1/embed trigger
# EMBEDDING_BATCH_SIZE=64      # texts per provider slice
# EMBEDDING_MAX_RETRIES=3      # retries per batch on transient failures (5xx/429/timeouts)
# EMBEDDING_RETRY_BACKOFF=0.5  # seconds, doubled each attempt

# Background processing (Day 12) — Redis + RQ worker pool
REDIS_URL=redis://127.0.0.1:6375/0
# QUEUE_NAME=knowflow                # RQ queue the workers pop from
# QUEUE_MAX_ATTEMPTS=3               # retry budget per ingestion job
# QUEUE_RETRY_BACKOFF=1.0            # seconds, doubled per retry
# QUEUE_WORKER_TIMEOUT=600           # seconds an RQ worker may run one task